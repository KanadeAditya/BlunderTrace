# Copy to .env and fill in. Never commit .env.
# Every setting below has a sensible default; only the API keys are worth setting.
# Full list and reasons: docs/BACKEND.md, section 10.

# --- AI providers (optional: without them the weakness cards use fixed glossary text) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# MAIN_MODEL=claude-haiku-5-5
# FALLBACK_MODEL=gpt-6-luna
# EMBEDDING_MODEL=text-embedding-3-small

# --- Tracing (optional) ---
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=blundertrace

# --- Database (docker compose `db` service; defaults shown) ---
POSTGRES_USER=blundertrace
POSTGRES_PASSWORD=blundertrace
POSTGRES_DB=blundertrace
POSTGRES_PORT=5432
DATABASE_URL=postgresql://blundertrace:blundertrace@localhost:5432/blundertrace

# --- App ---
APP_ENV=development
# LOG_LEVEL=INFO
# REPORT_REUSE_MINUTES=10
# MAX_ACTIVE_REPORTS=20

# --- Engine and capacity: one worker = one Stockfish = one CPU core ---
# STOCKFISH_PATH=stockfish
# ENGINE_NODES=100000
# ENGINE_HASH_MB=64
#
# Pick a profile for your machine (each worker uses ~360 MB for Stockfish plus Python):
#   Small server (2 cores, 2 GB):   WORKERS=1  WORKER_MEMORY=768m
#   Small server (2 cores, 4 GB):   WORKERS=2  WORKER_MEMORY=768m
#   Laptop (8+ cores, 16 GB+):      WORKERS=4  WORKER_MEMORY=1g
#   Bigger server (16 cores, 32 GB): WORKERS=12 WORKER_MEMORY=1g
WORKERS=2
WORKER_CPUS=1
WORKER_MEMORY=768m
