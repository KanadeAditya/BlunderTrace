# Copy to .env and fill in. Never commit .env.

# LLM providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Observability (optional)
LANGSMITH_API_KEY=

# Database (docker compose `db` service; defaults shown)
POSTGRES_USER=blundertrace
POSTGRES_PASSWORD=blundertrace
POSTGRES_DB=blundertrace
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://blundertrace:blundertrace@localhost:5432/blundertrace

# App
APP_ENV=development
